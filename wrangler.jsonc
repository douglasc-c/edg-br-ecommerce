{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edg-br-ecommerce",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "alias": {
    "./db.mjs": "./cloudflare/database.mjs",
    "./image-processor.mjs": "./cloudflare/image-processor.mjs"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "CommerceStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CommerceStore"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "APP_URL": "https://edg-br-ecommerce.douglas-camargo-ltda.workers.dev",
    "COMMERCE_MODE": "catalog",
    "STORE_NAME": "EDG Brasil",
    "STORE_DEFAULT_LANGUAGE": "pt-BR",
    "STORE_CURRENCY": "BRL",
    "PAYMENT_PROVIDER": "infinitepay",
    "SHIPPING_PROVIDER": "melhorenvio",
    "EUROPE_CHECKOUT_ENABLED": "false",
    "MELHOR_ENVIO_SANDBOX": "false"
  },
  "observability": {
    "enabled": true
  }
}
